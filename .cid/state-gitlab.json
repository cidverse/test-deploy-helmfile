            "slug": "gitlab-release-publish",
            "stage": "publish",
            "scope": "project",
            "action": "builtin://actions/gitlab-release-publish",
            "run-after": [
              "changelog-generate"
            ],
            "run-after-by-name": [
              "changelog-generate"
            ],
            "uses-output-of": [
              "changelog-generate"
            ],
            "uses-output-of-by-name": [
              "changelog-generate"
            ],
            "access": {
              "env": [
                {
                  "name": "CI_JOB_TOKEN",
                  "secret": true
                },
                {
                  "name": "GITLAB_TOKEN"
                },
                {
                  "name": "GITLAB_BOT_TOKEN"
                }
              ]
            },
            "inputs": {
              "artifacts": [
                {
                  "type": "changelog"
                },
                {
                  "type": "binary"
                },
                {
                  "type": "signature",
                  "format": "pgp"
                }
              ]
            },
            "outputs": {},
            "order": 1
          },
          {
            "id": "2",
            "name": "helmfile-deploy [deployment-helmfile-dev]",
