            "action": "builtin://actions/helmfile-deploy",
            "module": "helmfile-helmfile-yaml-gotmpl",
            "module-dir": ".",
            "run-after": [
              "changelog-generate",
              "gitlab-release-publish"
            ],
            "run-after-by-name": [
              "changelog-generate",
              "gitlab-release-publish"
            ],
            "access": {
              "env": [
                {
                  "name": "DEPLOYMENT_NAMESPACE"
                },
                {
                  "name": "KUBECONFIG_BASE64"
                },
                {
                  "name": "KUBECONFIG_.*_BASE64",
                  "pattern": true
                },
                {
                  "name": "HELMFILE_ARGS"
                }
              ],
              "executables": [
                {
                  "name": "helmfile",
                  "constraint": "\u003e=0.171.0"
